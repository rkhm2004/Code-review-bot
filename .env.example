# Copy to .env for local development. Never commit real secrets.
GITHUB_TOKEN=your_github_token_here
ALLOWED_REPOSITORIES=owner/repository
OLLAMA_MODEL=llama3.2:3b
RAG_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_DATA_DIR=/app/data/rag
AUDIT_DB_PATH=/app/data/cs4_audit.sqlite3
HF_HOME=/app/data/huggingface

CS4_AUTH_SECRET=replace_with_at_least_32_random_characters
CS4_AUTH_TTL_SECONDS=3600
CS4_ADMIN_USERNAME=admin
CS4_ADMIN_PASSWORD=replace_with_a_strong_password
CS4_ADMIN_SALT=replace_with_random_salt
# Optional: JSON array of additional users with precomputed scrypt hashes.
# Example shape: [{"username":"reviewer","passwordHash":"...","salt":"...","role":"REVIEWER"}]
CS4_USERS_JSON=[]
# Required for encrypted audit metadata in production. A 32-byte base64/URL-safe key is recommended.
CS4_AUDIT_ENCRYPTION_KEY=replace_with_a_secret_key
